#!@PYTHON@
"""Консольная точка входа lpkg (генерируется Makefile).

Пакет устанавливается в ``<prefix>/lib/pythonX.Y/site-packages``. Для
нестандартных префиксов (``/opt``, ``/usr/local`` и т. п.) этот каталог не
входит в ``sys.path`` системного интерпретатора, поэтому вычисляем его
относительно самого скрипта: ``<prefix>/bin/lpkg`` → ``<prefix>``.
"""

import os
import sys
import sysconfig


def _add_prefix_site() -> None:
    prefix = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    site = sysconfig.get_path("purelib", vars={"base": prefix, "platbase": prefix})
    if site and os.path.isdir(site) and site not in sys.path:
        sys.path.insert(0, site)


def main() -> int:
    _add_prefix_site()
    from lpkg.cli import main as cli_main

    return cli_main()


if __name__ == "__main__":
    sys.exit(main())
